
# .NET
# CMake
# Local-only test credentials - never commit real server logins
# OS / editor
# Retail FFXI game assets (copyrighted, gigabytes) - never committed, path is
# Vendored SDL3 devel zip extraction + our local VMA install prefix -
# regenerable via vendor/README.md, not committed (large binary/generated content)
# user-configured, this is just a safety net if it ever lands in-tree
.DS_Store
.vs/
.vscode/
/vendor/SDL3-*/
/vendor/vma-install/
Playonline Assets/
bin/
build-engine/
build/
local.credentials.json

# The bug-report webhook and the bot token that reads the channel back. These
# are written into a build at packaging time and belong in a build, not here -
# a repository is permanently searchable, keeps what you delete, and is
# scraped. See tools/package-*.sh.
bug-webhook.txt
bug-bot-token.txt
obj/
out/

# Dawn (WebGPU) checkout and build - large, regenerable via build-dawn.bat
# No trailing slashes: those match directories only, so a build tree redirected
# to another volume (a symlink on mac/linux, a junction on Windows) slips past
# them and shows up as an untracked file.
/vendor/dawn
build-dawn

# Dawn install prefix produced by build-dawn.bat
/vendor/dawn-install

# Renderer build tree - generated by build-renderer.bat / build-renderer.sh on
# every platform, so it belongs to nobody's checkout. A copy of this was
# committed from Windows; its CMakeCache.txt hardcodes absolute paths, so it is
# not portable even between two Windows machines.
/build-renderer
# Derived index of the local retail install - regenerable, install-specific
/ffxi-index.json

# Key tables lifted from the retail client - regenerate with tools/keytables.py
/keys/

__pycache__/

# scratch file written by tools/subrooms.py
tools/_mzb.tmp
moghouse.log

# Water surfaces, generated by tools/makewater.py from the server meshes.
# About 50MB, derived, and a minute to rebuild.
renderer/assets/water/*.water

# Packaged builds. Large, reproducible from tools/package-windows.ps1, and
# belong on a release rather than in history.
dist/

# Harness build output
/tools/loginzone/bin
/tools/loginzone/obj
*.unpacked.dll
